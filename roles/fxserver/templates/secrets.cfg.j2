# {{ ansible_managed }}
# Secrets for the game server, run by "exec secrets.cfg" in server.cfg. Mode 0600; never commit
# this file or copy it into a ticket.
sv_licenseKey "{{ fxserver_license_key }}"
# /perf/ basic auth: always set, because the server answers /perf/ to anyone when both are empty.
set sv_prometheusBasicAuthUser "{{ __fxserver_perf_user }}"
set sv_prometheusBasicAuthPassword "{{ __fxserver_perf_written_password }}"
{% for name, value in fxserver_secrets_cfg_extra | dictsort %}
set {{ name }} "{{ value }}"
{% endfor %}
