# {{ ansible_managed }}
# luminare.gameserver.fxserver: the game server (FXServer), started directly with server.cfg.
[Unit]
Description=Game server (FXServer)
Documentation=https://github.com/luminare-dev/ansible-collection-gameserver/tree/main/roles/fxserver
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User={{ fxserver_user }}
Group={{ fxserver_user }}
WorkingDirectory={{ fxserver_server_data_dir }}
# "current" points at the active build; the role switches it with one rename.
ExecStart=/bin/bash {{ fxserver_artifacts_dir }}/current/run.sh +exec server.cfg
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=mixed
SyslogIdentifier=fxserver

# Hardening: the server writes only below {{ fxserver_base_dir }} and private /tmp.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{ fxserver_base_dir }}
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
