# {{ ansible_managed }}
# luminare.gameserver.txadmin: txAdmin settings (TXHOST_* variables) for fxserver.service.
# systemd reads this file as root (EnvironmentFile= in fxserver.service.d/10-txadmin.conf); mode
# 0600, because it can hold the API token, the default account and deployer pre-fill secrets.
# Values stay unquoted: txAdmin stops at boot when a TXHOST_* value is surrounded by quotes.
# TXHOST_DATA_PATH is set in fxserver.service itself (fxserver_txdata_dir of the fxserver role).
{% for name, value in __txadmin_env %}
{{ name }}={{ value }}
{% endfor %}
{% for key, name in __txadmin_prefill_names.items() if key in txadmin_deployer_prefill %}
{{ name }}={{ txadmin_deployer_prefill[key] }}
{% endfor %}
